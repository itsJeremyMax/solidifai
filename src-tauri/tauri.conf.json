{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "solidifai",
  "version": "../package.json",
  "identifier": "com.solidifai.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "solidifai",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBM0NBMEEyNkVGQzZFQUQKUldTdGJ2eHVvcUE4MmtYQTVPbm5HTUtZMWJIYjBnTDdpamhjUEluNTgzb0QrbElYU2ttWXl3MEMK",
      "endpoints": [
        "https://github.com/itsJeremyMax/solidifai/releases/download/updater/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["solidifai"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
